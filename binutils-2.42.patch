diff '--color=auto' -ruN binutils-2.42/bfd/config.bfd ethereal-binutils-2.42/bfd/config.bfd
--- binutils-2.42/bfd/config.bfd	2024-01-28 18:00:00.000000000 -0600
+++ ethereal-binutils-2.42/bfd/config.bfd	2025-06-20 09:52:20.625804784 -0500
@@ -501,12 +501,26 @@
 
 #ifdef BFD64
   bpf-*-none)
-    targ_defvec=bpf_elf64_le_vec
+    targ_defvec=bpf_elf64_le_vec    
     targ_selvecs=bpf_elf64_be_vec
     targ_underscore=yes
     ;;
 #endif
 
+  i[3-7]86-*-ethereal*)
+    targ_defvec=i386_elf32_vec
+    targ_selvecs=
+    targ64_selvecs=x86_64_elf64_vec
+    ;;
+  
+#ifdef BFD64
+  x86_64-*-ethereal*)
+    targ_defvec=x86_64_elf64_vec
+    targ_slvecs=i386_ef32_vec
+    want64=true
+    ;;
+#endif
+
   epiphany-*-*)
     targ_defvec=epiphany_elf32_vec
     targ_underscore=yes
diff '--color=auto' -ruN binutils-2.42/config.sub ethereal-binutils-2.42/config.sub
--- binutils-2.42/config.sub	2024-01-28 18:00:00.000000000 -0600
+++ ethereal-binutils-2.42/config.sub	2025-06-20 09:52:20.725846713 -0500
@@ -1735,11 +1735,12 @@
 	# Now accept the basic system types.
 	# The portable systems comes first.
 	# Each alternative MUST end in a * to match a version number.
-	gnu* | android* | bsd* | mach* | minix* | genix* | ultrix* | irix* \
+	gnu* | android* | bsd* | mach* | minix* | genix* | ultrix* | irix* | ethereal* \
 	     | *vms* | esix* | aix* | cnk* | sunos | sunos[34]* \
 	     | hpux* | unos* | osf* | luna* | dgux* | auroraux* | solaris* \
 	     | sym* |  plan9* | psp* | sim* | xray* | os68k* | v88r* \
 	     | hiux* | abug | nacl* | netware* | windows* \
+	     | ethereal* \
 	     | os9* | macos* | osx* | ios* | tvos* | watchos* \
 	     | mpw* | magic* | mmixware* | mon960* | lnews* \
 	     | amigaos* | amigados* | msdos* | newsos* | unicos* | aof* \
