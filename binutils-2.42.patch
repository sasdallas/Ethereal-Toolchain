@@ -351,6 +351,10 @@
 			;;
 hppa*-*-openbsd*)	targ_emul=hppaobsd
 			;;
+i[3-7]86-*-ethereal*)	targ_emul=elf_i386_ethereal
+			targ_extra_emuls=elf_i386
+			targ64_extra_emuls="elf_x86_64_ethereal elf_x86_64"
+			;;
 i[3-7]86-*-nto-qnx*)	targ_emul=i386nto
 			;;
 i[3-7]86-*-go32)	targ_emul=i386go32
@@ -1025,6 +1029,10 @@
 			;;
 x86_64-*-solaris2*)	targ_emul=elf_x86_64_sol2
 			targ_extra_emuls="elf_x86_64 elf_i386_sol2 elf_i386_ldso elf_i386 elf_iamcu"
+			;;
+x86_64-*-ethereal*)
+			targ_emul=elf_x86_64_ethereal
+			targ_extra_emuls="elf_i386_ethereal elf_x86_64 elf_i386"
 			targ_extra_libpath=$targ_extra_emuls
 			tdir_elf_i386=`echo ${targ_alias} | sed -e 's/x86_64/i386/'`
 			;;
